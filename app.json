{
  "expo": {
    "name": "Hermes",
    "slug": "hermes-android",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hermes",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D0C0B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0C0B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.azygoss.hermes"
    },
    "android": {
      "package": "com.azygoss.hermes",
      "versionCode": 9,
      "adaptiveIcon": {
        "backgroundColor": "#0D0C0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Hermes uses the microphone for voice messages."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Hermes uses the camera to scan connection QR codes and take photos for the agent.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hermes lets you attach photos to messages.",
          "cameraPermission": "Hermes lets you take photos to send to the agent."
        }
      ],
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F7F5F0",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0D0C0B"
          }
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#FFBF00"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": false
          }
        }
      ],
      "expo-localization",
      "./plugins/withReleaseSigning",
      "./plugins/withShortcuts",
      "expo-background-task"
    ]
  }
}
